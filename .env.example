# NEXA has no required environment variables.
# Provider API keys belong to each user and live in their browser. Never put one here.
# A user's key must never become a NEXT_PUBLIC_* variable.

# PUBLIC: exposed to the browser. Used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://nexa.example.com

# SERVER: never exposed to the browser.
# Set to "false" to turn the optional relay off on this deployment.
NEXA_RELAY_ENABLED=true
# Comma-separated extra origins allowed to call the relay. Same origin is always allowed.
NEXA_RELAY_ALLOWED_ORIGINS=
